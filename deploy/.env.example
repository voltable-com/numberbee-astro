# Copy to `.env` beside this file (`cp .env.example .env`) — `docker compose
# pull` / `up` read it automatically when run in this directory.

# Where the image comes from (https://mini.local/registry — Docker Distribution
# behind nginx, so the repo is `mini.local/registry/numberbee-web`).
REGISTRY=mini.local/registry
# Required: one release/commit tag. Never `latest` — the TAG is what you bump to
# upgrade and roll back with.
TAG=

# Host side of the published port (`bind:host-port`); the container always
# listens on 8080. Loopback default → the TLS proxy mounts /game/numberbee/ here.
PUBLISH=127.0.0.1:8781
