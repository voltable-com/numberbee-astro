{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"types": ["astro/client", "vite-plugin-pwa/info"],
		"paths": {
			"@component/*": ["./src/components/*"],
			"@style/*": ["./src/styles/*"],
			"@script/*": ["./src/scripts/*"],
			"@layout/*": ["./src/layouts/*"],
			"@util/*": ["./utils/*"]
		}
	}
}
